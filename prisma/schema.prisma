generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String?
  name               String?
  image              String?
  provider           String?
  providerId         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  emailVerified      DateTime?
  role               Role                @default(USER)
  lastLoginAt        DateTime?
  addresses          Address[]
  cart               Cart?
  orders             Order[]
  reviews            Review[]
  stockNotifications StockNotification[]
  wishlist           Wishlist[]

  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String?
  street    String
  city      String
  state     String?
  zipCode   String?
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Category {
  id                String     @id @default(cuid())
  nameEn            String
  nameFa            String
  slug              String     @unique
  description       String?
  image             String?
  parentId          String?
  order             Int        @default(0)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  metaDescriptionEn String?
  metaDescriptionFa String?
  metaTitleEn       String?
  metaTitleFa       String?
  parent            Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryParent")
  products          Product[]

  @@map("categories")
}

model SkinType {
  id          String            @id @default(cuid())
  nameEn      String            @unique
  nameFa      String            @unique
  slug        String            @unique
  description String?
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductSkinType[]

  @@map("skin_types")
}

model Concern {
  id          String           @id @default(cuid())
  nameEn      String           @unique
  nameFa      String           @unique
  slug        String           @unique
  description String?
  order       Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    ProductConcern[]

  @@map("concerns")
}

model Product {
  id                 String              @id @default(cuid())
  nameEn             String
  nameFa             String
  slug               String              @unique
  descriptionEn      String?
  descriptionFa      String?
  images             String[]
  benefits           String[]
  ingredients        String[]
  howToUseEn         String?
  howToUseFa         String?
  origin             String?
  categoryId         String
  brand              String?
  isActive           Boolean             @default(true)
  isFeatured         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  status             ProductStatus       @default(DRAFT)
  benefitsEn         String[]
  benefitsFa         String[]
  ingredientsEn      String[]
  ingredientsFa      String[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  concerns           ProductConcern[]
  skinTypes          ProductSkinType[]
  category           Category            @relation(fields: [categoryId], references: [id])
  reviews            Review[]
  stockNotifications StockNotification[]
  variants           Variant[]
  wishlist           Wishlist[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductSkinType {
  productId  String
  skinTypeId String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinType   SkinType @relation(fields: [skinTypeId], references: [id], onDelete: Cascade)

  @@id([productId, skinTypeId])
  @@map("product_skin_types")
}

model ProductConcern {
  productId String
  concernId String
  createdAt DateTime @default(now())
  concern   Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, concernId])
  @@map("product_concerns")
}

model Variant {
  id                 String              @id @default(cuid())
  productId          String
  size               String
  price              Float
  discountPercent    Float?  
  comparePrice       Float?
  stock              Int                 @default(0)
  sku                String              @unique
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cartItems          CartItem[]
  orderItems         OrderItem[]
  stockNotifications StockNotification[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("variants")
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  abandonedAt DateTime?
  expiresAt   DateTime?
  items       CartItem[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  variant   Variant  @relation(fields: [variantId], references: [id])

  @@map("cart_items")
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String
  status                OrderStatus @default(PENDING)
  total                 Float
  subtotal              Float
  tax                   Float       @default(0)
  shippingCost          Float       @default(0)
  discount              Float       @default(0)
  shippingAddress       Json
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paymentStatus         String?
  stripeCustomerId      String?
  stripePaymentIntentId String?
  items                 OrderItem[]
  user                  User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float
  productId String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  variant   Variant  @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Review {
  id                 String    @id @default(cuid())
  userId             String
  productId          String
  rating             Int
  title              String?
  commentEn          String?
  commentFa          String?
  images             String[]
  isVerifiedPurchase Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isApproved         Boolean   @default(false)
  adminResponseAt    DateTime?
  adminResponseEn    String?
  adminResponseFa    String?
  helpfulCount       Int       @default(0)
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model StockNotification {
  id         String   @id @default(cuid())
  email      String
  variantId  String
  userId     String?
  isNotified Boolean  @default(false)
  productId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([email, variantId])
  @@map("stock_notifications")
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType @default(PERCENTAGE)
  value        Float
  minimumOrder Float?
  maxDiscount  Float?
  usageLimit   Int?
  usedCount    Int        @default(0)
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("coupons")
}

model HeroSlide {
  id          String   @id @default(cuid())
  image       String
  imageMobile String?
  titleEn     String?
  titleFa     String?
  subtitleEn  String?
  subtitleFa  String?
  ctaTextEn   String?
  ctaTextFa   String?
  ctaLink     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_slides")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
