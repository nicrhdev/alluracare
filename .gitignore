cat > .gitignore << 'EOF'
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build outputs
.next/
out/
dist/
build/
.vercel/
.netlify/

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Prisma
prisma/*.db
prisma/*.db-journal

# Cloudflare
.wrangler/
.cloudflare/

# Other
*.pem
*.key
*.cert
EOFpackage-lock.json
